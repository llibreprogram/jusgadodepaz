echo >>"%TEMP_FILE%"
powershell -Command "$content = [System.Convert]::FromBase64String((Get-Content \"%TEMP_FILE%\" -Raw)); [System.IO.File]::WriteAllBytes(\"main.py\", $content)"
del "%TEMP_FILE%"

