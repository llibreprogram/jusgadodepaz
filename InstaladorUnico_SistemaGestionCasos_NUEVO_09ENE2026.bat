@echo off
setlocal EnableDelayedExpansion
chcp 65001 >nul

REM Check if running in CHILD mode (to prevent auto-close)
if "%1"=="CHILD" goto MAIN

REM Start in CHILD mode with cmd /k to keep window open on errors
cmd /k "%~f0" CHILD
exit /b

:MAIN
color 0A
title Instalador Único - Sistema de Gestión de Casos

